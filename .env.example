## Frontend (Vite) environment variables
## Copy this file to `.env.local` and fill values.

# OpenAI key used by the current demo frontend implementation.
# IMPORTANT: For production (App Store / Play Store) you should NOT ship an OpenAI key in the app.
# Move AI calls to your backend and call your backend from the app instead.
VITE_OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Optional model overrides
VITE_OPENAI_TEXT_MODEL=gpt-4.1-mini
VITE_OPENAI_IMAGE_MODEL=gpt-image-1

